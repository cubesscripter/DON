-- Gradient rotation animation
spawn(function()
    local rotation = 0
    while ScreenGui.Parent do
        rotation = rotation + 0.5
        BGGradient.Rotation = rotation % 360
        
        -- Animate accent line gradient
        AccentGrad.Offset = Vector2.new(math.sin(tick() * 2) * 0.3, 0)
        
        -- Animate key stroke color
        local hue = (tick() * 20) % 360
        local color = Color3.fromHSV(hue/360, 0.6, 0.8)
        KeyStroke.Color = color
        
        RunService.Heartbeat:Wait()
    end
end)

-- Ring rotation animation
spawn(function()
    local rot1 = 0
    local rot2 = 0
    while Ring1.Parent do
        rot1 = rot1 + 1
        rot2 = rot2 - 1.5
        Ring1.Rotation = rot1
        Ring2.Rotation = rot2
        RunService.Heartbeat:Wait()
    end
end)

-- Hover effects
local function SetupHover(button, frame)
    button.MouseEnter:Connect(function()
        TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {
            Size = frame.Size + UDim2.new(0, 4, 0, 4),
            Position = frame.Position - UDim2.new(0, 2, 0, 2)
        }):Play()
    end)
    button.MouseLeave:Connect(function()
        TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {
            Size = UDim2.new(0, 380, 0, 48),
            Position = UDim2.new(0.5, -190, 0, 215)
        }):Play()
