local function ShakeFrame(frame)
    local originalPos = frame.Position
    for i = 1, 5 do
        TweenService:Create(frame, TweenInfo.new(0.05), {
            Position = originalPos + UDim2.new(0, math.random(-8, 8), 0, 0)
        }):Play()
        wait(0.05)
    end
    TweenService:Create(frame, TweenInfo.new(0.05), {
        Position = originalPos
    }):Play()
end

